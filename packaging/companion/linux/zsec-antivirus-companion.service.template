[Unit]
Description=ZSEC Antivirus per-user post-change companion (not primary or pre-access protection)
Documentation=https://talktoai.org/zero-security/
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart="@@LAUNCHER@@" "@@CONFIG_DIR@@"
Restart=on-failure
RestartSec=30s
TimeoutStopSec=20s
KillMode=control-group
UMask=0077
Nice=10
CPUWeight=25
IOWeight=25
MemoryMax=512M
TasksMax=64
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="@@STATE_DIR@@"
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
